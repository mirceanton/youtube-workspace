# Configuration reference. Every setting comes from environment variables; never commit real values.
#
# Local development: copy this file to `.env` at the repository root.
# - `pnpm dev` starts the web server and the MCP server with this file loaded, then
#   `apps/<app>/.env` (if present) on top of it. Values that differ per process (PORT,
#   DATABASE_URL) therefore belong in apps/web-server/.env and apps/mcp/.env.
# - The Vite dev server (web UI) reads only WEB_UI_PORT and WEB_SERVER_URL from this file.
# - Because the servers load this file, never put the superuser MIGRATION_DATABASE_URL in it.
# Production: set the variables on each container; no file is read.
#
# The example values match the dev-only Postgres from `scripts/pg-local.sh start` or
# `docker compose up -d` (user postgres, password postgres, database youtube_workspace).
# Lines that are commented out are optional or not used yet.
# Adding variables: append a `# --- <area> ---` section at the end of this file (CLAUDE.md).

# --- Database -------------------------------------------------------------------------------------

# Privileged connection used only by `pnpm migrate`. Migrations create the schema, the fixed roles
# (ytw_web, ytw_mcp, ytw_readonly) and their grants. It is a superuser credential, so pass it to
# that command only, never through .env (`pnpm dev` also strips it from the servers' environment):
#   MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/youtube_workspace pnpm migrate
# MIGRATION_DATABASE_URL=

# The process's own least-privilege role: ytw_web for the web server, ytw_mcp for the MCP server.
# Set it per process, for example:
#   apps/web-server/.env  DATABASE_URL=postgres://ytw_web:<password>@localhost:5432/youtube_workspace
#   apps/mcp/.env         DATABASE_URL=postgres://ytw_mcp:<password>@localhost:5432/youtube_workspace
# DATABASE_URL=

# Read-only role used only by the MCP `query_sql` tool.
# READONLY_DATABASE_URL=postgres://ytw_readonly:<password>@localhost:5432/youtube_workspace

# --- Both services --------------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent (default info)
# LOG_LEVEL=info

# Interface to listen on (default 0.0.0.0).
# HOST=0.0.0.0

# Listening port. Defaults: web server 3000, MCP server 3001. Set it per process, never here, or
# both servers would try to use the same port.
# PORT=

# Release version and git commit shown on /healthz. Container builds set these.
# APP_VERSION=
# GIT_SHA=

# --- Web UI dev server (pnpm dev only) ------------------------------------------------------------

# Port of the Vite dev server (default 5173; if it is taken Vite uses the next free port, which
# then no longer matches OIDC_REDIRECT_URI).
# WEB_UI_PORT=5173
# Where the dev server proxies /api and /auth (default http://127.0.0.1:3000).
# WEB_SERVER_URL=http://127.0.0.1:3000

# --- Web server: OIDC login -----------------------------------------------------------------------

# Provider issuer; discovery uses <issuer>/.well-known/openid-configuration.
# OIDC_ISSUER_URL=http://localhost:8080/realms/youtube-workspace
# Confidential client credentials.
# OIDC_CLIENT_ID=youtube-workspace
# OIDC_CLIENT_SECRET=
# Callback URL registered with the provider (the browser reaches /auth/* through the web UI origin).
# OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# Where the groups list lives in the token claims, and the group a user must be in to sign in.
# OIDC_GROUPS_CLAIM_PATH=groups
# OIDC_REQUIRED_GROUP=youtube-workspace-users

# --- Web server: sessions -------------------------------------------------------------------------

# Secret for session cookies and refresh-token encryption; at least 32 random characters,
# e.g. the output of `openssl rand -base64 48`.
# SESSION_SECRET=
# Idle timeout (default 8 hours) and absolute timeout (default 7 days).
# SESSION_IDLE_TIMEOUT=
# SESSION_ABSOLUTE_TIMEOUT=

# --- Both services: observability -----------------------------------------------------------------

# When set (at least 16 characters, e.g. the output of `openssl rand -base64 24`), GET /metrics
# requires `Authorization: Bearer <token>`. MUST be set whenever /metrics is reachable beyond a
# private network: when unset the endpoint is open, and the MCP tool-call metrics contain API token
# names. Set it per process or here.
# METRICS_TOKEN=

# --- keycloak -------------------------------------------------------------------------------------

# Dev-only values for the Keycloak realm in dev/keycloak (`docker compose up -d keycloak`, or
# `pnpm dev:stack` for Postgres and Keycloak together). They are active, not commented out, so a
# copied .env logs in against the local realm as is; they take precedence over the commented
# examples in the OIDC section above. docs/keycloak.md lists the two dev users and explains how to
# use a real provider instead. The client secret is public and must never be used anywhere real.
OIDC_ISSUER_URL=http://localhost:8080/realms/youtube-workspace
OIDC_CLIENT_ID=youtube-workspace
OIDC_CLIENT_SECRET=dev-only-secret
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_GROUPS_CLAIM_PATH=groups
OIDC_REQUIRED_GROUP=youtube-workspace-users

# --- database roles (pnpm migrate) ----------------------------------------------------------------

# Passwords `pnpm migrate` sets for the fixed roles (sent as SCRAM verifiers, never logged):
# 16-256 printable ASCII characters, e.g. the output of `openssl rand -hex 24`. Unset: the role
# keeps its current password. These are dev-only values; the @ytw/db test harness uses the same
# ones, so running tests never changes what a local server logs in with. The matching per-process
# URLs, for apps/web-server/.env, apps/mcp/.env and READONLY_DATABASE_URL:
#   postgres://ytw_web:ytw-web-dev-password@localhost:5432/youtube_workspace
#   postgres://ytw_mcp:ytw-mcp-dev-password@localhost:5432/youtube_workspace
#   postgres://ytw_readonly:ytw-readonly-dev-password@localhost:5432/youtube_workspace
# In production set them only on the migration job. docs/database.md explains the roles.
YTW_WEB_PASSWORD=ytw-web-dev-password
YTW_MCP_PASSWORD=ytw-mcp-dev-password
YTW_READONLY_PASSWORD=ytw-readonly-dev-password

# Optional: a database that every concurrent `pnpm migrate` against this Postgres cluster also
# locks (e.g. the `postgres` maintenance database). The roles are cluster-wide, so runs migrating
# different databases of one cluster at the same time must share it. Unset: only the target
# database is locked, which is enough for one database per cluster.
# MIGRATION_LOCK_DATABASE_URL=

# --- tests ----------------------------------------------------------------------------------------

# Superuser connection the @ytw/db test harness uses to create and drop throwaway databases.
# Unset: postgres://postgres:postgres@localhost:5432/postgres, which `scripts/pg-local.sh url`
# prints (docker compose uses the same). MIGRATION_DATABASE_URL is never used for tests. The server
# must be on this machine (localhost, 127.x, ::1, a Unix socket) unless declared disposable below.
# TEST_DATABASE_URL=

# Set to 1 only for a throwaway test server: tests may then use a server on another machine, and
# the harness may overwrite the application roles' passwords there. Never set it for a server that
# holds anything you want to keep.
# YTW_DISPOSABLE_TEST_SERVER=

# --- web server session secret (dev placeholder only) -------------------------------------------------

# Required by the web server. Replace it with a random secret in every deployed environment.
SESSION_SECRET=dev-only-session-secret-change-this-before-use
# Optional: defaults to 8 hours idle and 7 days absolute.
# SESSION_IDLE_TIMEOUT=28800
# SESSION_ABSOLUTE_TIMEOUT=604800
