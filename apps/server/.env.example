# Copy to apps/server/.env for local development (`pnpm dev` loads the root .env, then this file).
# In production every setting is an environment variable of the container; see README.md.

# Postgres role that owns the database. Migrations run with it when the server boots, so it needs
# nothing beyond owning the database (CloudNativePG's `app` user does). The value below is the
# database of `docker compose up -d postgres`, whose `postgres` user is a superuser: that works,
# but the query_sql MCP tool is switched off for a superuser. For query_sql, use a plain owner:
#   docker compose exec postgres psql -U postgres -c "CREATE ROLE ytw LOGIN PASSWORD 'ytw'" \
#     -c "ALTER DATABASE youtube_workspace OWNER TO ytw"
# and DATABASE_URL=postgres://ytw:ytw@localhost:5432/youtube_workspace (do this before the first
# start, or recreate the database).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/youtube_workspace

# Listen address and log level (fatal | error | warn | info | debug | trace | silent). Without
# OIDC there is no login, so development listens on the loopback interface only (the default,
# 0.0.0.0, is for the container).
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Shown on /healthz; the container image build sets them.
# APP_VERSION=0.0.0-dev
# GIT_SHA=unknown

# Directory of the built web app (apps/web/dist). Leave unset in development, where the Vite dev
# server (http://localhost:5173) serves the app and proxies /api and /auth here.
# STATIC_WEB_DIR=

# When set, GET /metrics needs `Authorization: Bearer <token>` (at least 16 characters).
# METRICS_TOKEN=

# The MCP token for your LLM gateway, created on the first boot. `ytw_` plus 43 base64url
# characters; generate one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '=' | sed 's/^/ytw_/'
# The environment wins: a different value replaces the token, and unsetting it revokes it.
# MCP_BOOTSTRAP_TOKEN=

# Name the audit log shows for calls made with that token.
# MCP_BOOTSTRAP_TOKEN_NAME=bootstrap

# Its levels (none, read or write per object; the activity log is none or read at most).
# MCP_BOOTSTRAP_TOKEN_PERMISSIONS=ideas=write,scripts=write,experiments=write,videos=write,notes=write,activity=read

# OIDC login (Authelia, Authentik, Zitadel, ...). Leave all of these unset for single-user mode:
# no login, every web request is the local owner. If you set any OIDC_* variable, the four marked
# below and SESSION_SECRET are required. Outside localhost both URLs must be HTTPS.
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=youtube-workspace
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Only members of this group may sign in, read from the claim at OIDC_GROUPS_CLAIM_PATH.
# OIDC_REQUIRED_GROUP=youtube-workspace-users
# OIDC_GROUPS_CLAIM_PATH=groups

# At least 32 characters; signs the CSRF tokens and encrypts the refresh token and ID token kept
# in the database. Generate one with: openssl rand -base64 48
# SESSION_SECRET=

# Session lifetimes in seconds: 8 hours idle, 7 days in total.
# SESSION_IDLE_TIMEOUT=28800
# SESSION_ABSOLUTE_TIMEOUT=604800
