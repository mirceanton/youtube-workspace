{
  "name": "@ytw/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "@ytw/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "@ytw/source": "./src/testing.ts",
      "types": "./dist/src/testing.d.ts",
      "default": "./dist/src/testing.js"
    }
  },
  "scripts": {
    "dev": "env -u MIGRATION_DATABASE_URL tsx watch --conditions=@ytw/source --env-file-if-exists=../../.env --env-file-if-exists=.env src/index.ts",
    "build": "tsc -b",
    "start": "node dist/src/index.js",
    "lint": "tsc -b && oxlint --deny-warnings",
    "test": "vitest run",
    "docs:mcp": "tsx scripts/generate-docs.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@ytw/db": "workspace:*",
    "@ytw/observability": "workspace:*",
    "@ytw/policy": "workspace:*",
    "@ytw/script-md": "workspace:*",
    "@ytw/shared": "workspace:*",
    "@ytw/tokens": "workspace:*",
    "fastify": "catalog:",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "^8.23.0"
  }
}
