{
  "name": "@ytw/admin-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "ytw-admin": "./dist/src/bin/ytw-admin.js"
  },
  "exports": {
    ".": {
      "@ytw/source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "tsc -b && oxlint --deny-warnings",
    "test": "vitest run",
    "ytw-admin": "tsx --conditions=@ytw/source --env-file-if-exists=../../.env src/bin/ytw-admin.ts"
  },
  "dependencies": {
    "@ytw/db": "workspace:*",
    "@ytw/policy": "workspace:*",
    "@ytw/shared": "workspace:*",
    "@ytw/tokens": "workspace:*",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.0"
  }
}
