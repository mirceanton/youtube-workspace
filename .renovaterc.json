{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>mirceanton/renovate-config//default.json5"],
  "packageRules": [
    {
      "description": "One update for the Node version pinned in .mise.toml and in the Dockerfiles",
      "matchManagers": ["mise", "dockerfile"],
      "matchPackageNames": ["node"],
      "groupName": "node"
    }
  ]
}
