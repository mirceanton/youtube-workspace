{
  "realm": "youtube-workspace",
  "displayName": "YouTube Workspace (dev)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "registrationEmailAsUsername": false,
  "rememberMe": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 604800,
  "groups": [
    {
      "name": "youtube-workspace-users",
      "path": "/youtube-workspace-users",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    }
  ],
  "users": [
    {
      "username": "owner",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Owner",
      "email": "owner@youtube-workspace.test",
      "credentials": [{ "type": "password", "value": "owner-dev-pass", "temporary": false }],
      "groups": ["/youtube-workspace-users"],
      "requiredActions": []
    },
    {
      "username": "outsider",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "Outsider",
      "email": "outsider@youtube-workspace.test",
      "credentials": [{ "type": "password", "value": "outsider-dev-pass", "temporary": false }],
      "groups": [],
      "requiredActions": []
    }
  ],
  "clients": [
    {
      "clientId": "youtube-workspace",
      "name": "YouTube Workspace (dev)",
      "description": "Confidential client of the web server (backend-for-frontend). Dev only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://127.0.0.1:3000/auth/callback",
        "http://localhost:5173/auth/callback",
        "http://127.0.0.1:5173/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*##http://127.0.0.1:3000/*##http://localhost:5173/*##http://127.0.0.1:5173/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "multivalued": "true",
            "claim.name": "groups",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
